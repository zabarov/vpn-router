{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rim/vpn-router/schema/config.schema.json",
  "title": "VPN Router configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources", "capture", "egresses", "policies", "destination_sets", "traffic_handling", "resources"],
  "properties": {
    "schema_version": { "enum": ["2.0", "3.0"] },
    "routing_data": { "$ref": "#/$defs/routingData" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "listen_port"],
      "properties": {
        "type": { "const": "redirect" },
        "listen_port": { "type": "integer", "minimum": 1024, "maximum": 65535 }
      }
    },
    "egresses": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/egress" } },
    "policies": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/$defs/policy" } },
    "destination_sets": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9-]{1,62}$": {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            { "required": ["ip_cidrs"], "properties": { "ip_cidrs": { "type": "array", "minItems": 1 } } },
            { "required": ["country_codes"], "properties": { "country_codes": { "type": "array", "minItems": 1 } } },
            { "required": ["exact_domains"], "properties": { "exact_domains": { "type": "array", "minItems": 1 } } },
            { "required": ["domain_suffixes"], "properties": { "domain_suffixes": { "type": "array", "minItems": 1 } } }
          ],
          "properties": {
            "ip_cidrs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9.]+/(?:[0-9]|[12][0-9]|3[0-2])$" } },
            "country_codes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
            "exact_domains": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$", "maxLength": 253 } },
            "domain_suffixes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$", "maxLength": 254 } }
          }
        }
      }
    },
    "traffic_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["udp_quic", "ipv6", "dns_mode"],
      "properties": {
        "udp_quic": { "const": "reject" },
        "ipv6": { "const": "reject" },
        "dns_mode": { "enum": ["managed", "system"] }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nftables_table", "service_name"],
      "properties": {
        "nftables_table": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,31}$" },
        "service_name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" }
      }
    }
  },
  "$defs": {
    "tag": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "duration": { "type": "string", "pattern": "^[1-9][0-9]*(?:m|h|d)$" },
    "routingData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "country_provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "refresh_interval", "max_stale"],
          "properties": {
            "type": { "const": "ripestat" },
            "refresh_interval": { "$ref": "#/$defs/duration" },
            "max_stale": { "$ref": "#/$defs/duration" }
          }
        },
        "domain_resolver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["refresh_interval", "min_ttl", "max_ttl", "max_stale"],
          "properties": {
            "refresh_interval": { "$ref": "#/$defs/duration" },
            "min_ttl": { "type": "integer", "minimum": 30, "maximum": 86400 },
            "max_ttl": { "type": "integer", "minimum": 60, "maximum": 604800 },
            "max_stale": { "$ref": "#/$defs/duration" }
          }
        }
      }
    },
    "tunnelClients": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "addresses"],
          "properties": {
            "mode": { "const": "address_list" },
            "addresses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9.]+/32$" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "subnet"],
          "properties": {
            "mode": { "const": "subnet" },
            "subnet": { "type": "string", "pattern": "^(?!0\\.0\\.0\\.0/0$)[0-9.]+/(?:[0-9]|[12][0-9]|3[0-2])$" }
          }
        }
      ]
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "type", "namespace", "interface", "clients"],
          "properties": {
            "tag": { "$ref": "#/$defs/tag" },
            "type": { "const": "tunnel_interface" },
            "namespace": { "const": "host" },
            "interface": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,14}$" },
            "clients": { "$ref": "#/$defs/tunnelClients" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "type", "namespace", "container_name", "interface", "clients"],
          "properties": {
            "tag": { "$ref": "#/$defs/tag" },
            "type": { "const": "tunnel_interface" },
            "namespace": { "const": "container" },
            "container_name": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$" },
            "interface": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,14}$" },
            "clients": { "$ref": "#/$defs/tunnelClients" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "type", "container_name", "clients"],
          "properties": {
            "tag": { "$ref": "#/$defs/tag" },
            "type": { "const": "container_egress" },
            "container_name": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$" },
            "clients": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": { "mode": { "const": "all" } }
            }
          }
        }
      ]
    },
    "egress": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "type"],
          "properties": { "tag": { "$ref": "#/$defs/tag" }, "type": { "const": "direct" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "type", "auth_key_env", "exit_node", "proxy_server", "proxy_port", "healthcheck_url"],
          "properties": {
            "tag": { "$ref": "#/$defs/tag" },
            "type": { "const": "tailscale_socks" },
            "auth_key_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" },
            "exit_node": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,252}$" },
            "proxy_server": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,252}$" },
            "proxy_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "healthcheck_url": { "type": "string", "pattern": "^https://\\S+$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "type", "server", "port", "healthcheck_url"],
          "properties": {
            "tag": { "$ref": "#/$defs/tag" },
            "type": { "const": "socks5" },
            "server": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,252}$" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "healthcheck_url": { "type": "string", "pattern": "^https://\\S+$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "type", "interface", "healthcheck_url"],
          "properties": {
            "tag": { "$ref": "#/$defs/tag" },
            "type": { "const": "linux_interface" },
            "interface": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,14}$" },
            "healthcheck_url": { "type": "string", "pattern": "^https://\\S+$" }
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "destination_sets", "egress", "failure_mode"],
      "properties": {
        "tag": { "$ref": "#/$defs/tag" },
        "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/tag" } },
        "destination_sets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/tag" } },
        "egress": { "$ref": "#/$defs/tag" },
        "failure_mode": { "enum": ["block", "direct"] }
      }
    }
  }
}
